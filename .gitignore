# ==================================================
# IAR build output directories
# ==================================================
**/EWARM/App/
**/EWARM/Bootloader/
**/EWARM/Debug/
**/EWARM/Release/

# IAR local IDE settings
**/EWARM/settings/

# Automatically generated Git version header
**/App/User/App/Inc/git_version.h

# ==================================================
# Compiled files
# ==================================================
*.o
*.obj
*.out
*.elf
*.bin
*.hex
*.map

# ==================================================
# IAR generated files
# ==================================================
*.dep
*.pbd
*.pbd.*
*.pbi
*.pbi.*
*.xcl
*.pbw
*.dnx
*.sim
*.reggroups

# IAR cache
**/.cache/

# IAR C-STAT / C-RUN generated data
# Remove this rule if these files need to be shared.
*.ewt

# build_state.json and Release binaries are already
# excluded by **/EWARM/App/.

# ==================================================
# Ninja generated files
# ==================================================
.ninja_deps
.ninja_log
build.ninja
rules.ninja

# ==================================================
# VS Code personal settings
# ==================================================
.vscode/settings.json
*.code-workspace

# Keep other JSON files eligible for version control.
# Do not add a global *.json rule.

# ==================================================
# Logs, temporary files, and backups
# ==================================================
*.log
*.tmp
*.bak
*.~*
~$*

# ==================================================
# Windows / macOS generated files
# ==================================================
Thumbs.db
Desktop.ini
.DS_Store

# ==================================================
# Logic analyzer captures
# ==================================================
*.sal

# ==================================================
# Measurement data
# ==================================================
**/측정자료/
**/MeasurementData/